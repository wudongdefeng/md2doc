{
  "name": "md2doc",
  "version": "0.2.1",
  "description": "CLI + Web: convert Markdown to .docx with a prettier web UI and Vercel deployment",
  "main": "src/convert.js",
  "bin": {
    "md2doc": "bin/md2doc.js"
  },
  "scripts": {
    "cli": "node bin/md2doc.js",
    "legacy-server": "node src/server.js",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node bin/md2doc.js example/example.md -o example/output.docx"
  },
  "keywords": [
    "markdown",
    "md",
    "docx",
    "convert",
    "cli",
    "server",
    "online"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.0.0",
    "fs-extra": "^11.1.1",
    "marked": "^5.1.1",
    "html-to-docx": "^1.0.0",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "next": "^13.4.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^8.0.7"
  }
}
